{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatomato-docs",
  "compatibility_date": "2026-11-18",
  // Static files only: no Worker script, so every request is a free asset request
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Cloudflare creates the DNS record and the certificate for a custom domain itself.
  // Keep the host in step with SITE_URL in src/consts.mjs.
  "routes": [{ "pattern": "docs.whatomato.habibium.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
